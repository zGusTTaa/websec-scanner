# Copie este arquivo para .env e preencha com seus valores
# cp .env.example .env

# ===== Configurações do scanner =====
WEBSEC_TIMEOUT=10
WEBSEC_THREADS=10
WEBSEC_USER_AGENT=WebSecScanner/0.1

# ===== Caminhos =====
WEBSEC_OUTPUT_DIR=./reports
WEBSEC_PAYLOADS_DIR=./websec/payloads

# ===== Proxy (opcional) =====
# WEBSEC_PROXY=http://127.0.0.1:8080

# ===== Notificações (opcional) =====
# WEBSEC_WEBHOOK_URL=https://discord.com/api/webhooks/...